# ─── Google OAuth ───────────────────────────────────────────────
# Obtenha em: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret

# ─── NextAuth ────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=gere-uma-string-aleatoria-longa-aqui
NEXTAUTH_URL=https://seu-app.vercel.app

# ─── E-mails autorizados ─────────────────────────────────────────
# Separe por vírgula, sem espaços
ALLOWED_EMAILS=email1@gmail.com,email2@gmail.com

# ─── Upstash Redis (banco de dados) ──────────────────────────────
# Obtenha em: https://console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=seu-token-aqui
